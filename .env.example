# Red Set ProtoCell - Docker Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================

# Environment mode: "development" or "production"
RSP_ENVIRONMENT=development

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Comma-separated list of allowed origins for CORS
# For Docker development, use: http://localhost:3000
# For production: https://red-set-protocell.vercel.app
RSP_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# FRONTEND API CONFIGURATION
# =============================================================================

# Frontend API base URL (where the frontend will call the backend)
# For local development: http://localhost:8000
# For production: https://red-set-protocell.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# API KEYS (REQUIRED - NEVER COMMIT THESE!)
# =============================================================================

# OpenAI API Key (required for OpenAI backend)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (required for Anthropic backend)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# Demo admin password (REQUIRED)
# Set to a strong password for the demo admin user
RSP_DEMO_PASSWORD=changeme

# Enable authentication (true/false)
# Set to false for development, true for production
RSP_REQUIRE_AUTH=false

# JWT Secret (only needed if RSP_REQUIRE_AUTH=true)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RSP_JWT_SECRET=

# =============================================================================
# RATE LIMITING
# =============================================================================

# Maximum requests per minute per IP address
RSP_RATE_LIMIT_PER_MIN=60

# Maximum requests per hour per IP address
RSP_RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# DOCKER NOTES
# =============================================================================

# Frontend will be available at: http://localhost:3000
# Backend API will be available at: http://localhost:8000
# The services communicate internally over Docker network using service names
#
# To run:
#   docker compose up --build
#
# To stop:
#   docker compose down
#
# To stop and remove volumes:
#   docker compose down -v
#
# Production deployment:
# - Set VITE_API_BASE_URL to your production API domain
# - Set RSP_ENVIRONMENT=production
# - Set RSP_REQUIRE_AUTH=true
# - Generate strong RSP_JWT_SECRET
# - Update RSP_ALLOWED_ORIGINS with your frontend domain
