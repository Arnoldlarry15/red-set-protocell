# Vercel Deployment Ignore File
# Files and directories that should not be included in the deployment

# Backend development files (we use serverless functions instead)
backend/
*.db
*.db-journal

# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
tests/

# Development files
.env
.env.*
!.env.example
!.env.local.example
*.key
*.pem
secrets/

# Documentation (not needed in deployment)
*.md
!README.md
docs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.github/
.gitignore
.gitguardian.yaml

# Demo and export directories
demo_exports/
demo_benchmarks/
benchmark_results/
telemetry_exports/

# Docker files
Dockerfile
docker-compose.yaml
.dockerignore

# Other build artifacts
*.log
*.tmp
/tmp/

# Large images
*.png
*.jpg
*.jpeg
