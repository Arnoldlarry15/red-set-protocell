# Red Set ProtoCell - Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================

# Environment mode: "development" or "production"
# In production, security features are enforced
RSP_ENVIRONMENT=development

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Comma-separated list of allowed origins for CORS
# REQUIRED in production mode
# Example: https://app.example.com,https://dashboard.example.com
RSP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# API KEYS (NEVER COMMIT THESE!)
# =============================================================================

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (optional)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Secret Key - REQUIRED FOR PRODUCTION
# SECURITY WARNING: This MUST be set to a strong random value in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER commit the actual secret to version control!
RSP_JWT_SECRET=your-very-long-random-secret-key-here

# JWT token expiration in hours
RSP_JWT_EXPIRATION_HOURS=24

# Enable JWT authentication (true/false)
# SECURITY WARNING: MUST be 'true' in production
# Set to false ONLY for local development
RSP_REQUIRE_AUTH=false

# Demo admin password
# SECURITY WARNING: This is a demo authentication system for development only
# The password is hashed using PBKDF2 but users are stored in memory
# IN PRODUCTION: Implement proper user management with a database
# REQUIRED: Set this to a strong password - it must not be left empty
# Example: RSP_DEMO_PASSWORD=your_secure_random_password_here
RSP_DEMO_PASSWORD=

# API Keys for programmatic access (optional)
# Format: key1:role1,key2:role2
# Roles: admin, researcher, observer
# Example: abc123:admin,def456:researcher
# SECURITY WARNING: Store actual API keys in a secure secrets manager
RSP_API_KEYS=

# =============================================================================
# RATE LIMITING
# =============================================================================

# Maximum requests per minute per IP address
RSP_RATE_LIMIT_PER_MIN=60

# Maximum requests per hour per IP address
RSP_RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite database path
RSP_DB_PATH=rsp_session.db

# PostgreSQL connection string (optional, for production)
# Example: postgresql://user:password@localhost:5432/rsp
RSP_POSTGRES_URI=

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
RSP_LOG_LEVEL=INFO

# Log file path (optional, defaults to stdout)
RSP_LOG_FILE=

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================

# Maximum number of concurrent WebSocket connections
RSP_MAX_WEBSOCKET_CONNECTIONS=100

# =============================================================================
# SESSION STORAGE
# =============================================================================

# Directory for session data
RSP_SESSIONS_DIR=sessions

# =============================================================================
# MONITORING & OBSERVABILITY (Optional)
# =============================================================================

# Sentry DSN for error tracking (optional)
# Get yours at: https://sentry.io/
SENTRY_DSN=

# Rollbar access token (optional)
# Get yours at: https://rollbar.com/
ROLLBAR_TOKEN=

# =============================================================================
# NOTES
# =============================================================================

# For production deployment:
# 1. Set RSP_ENVIRONMENT=production
# 2. Set RSP_ALLOWED_ORIGINS to your actual domain(s)
# 3. Generate a strong RSP_JWT_SECRET (min 32 characters)
# 4. Change RSP_DEMO_PASSWORD to a strong password (or implement proper user management)
# 5. Set RSP_REQUIRE_AUTH=true
# 6. Configure monitoring tools (Sentry, etc.)
# 7. Review and adjust rate limits based on your needs
# 8. Use PostgreSQL for production databases instead of SQLite
# 9. Set up log aggregation and monitoring
# 10. Configure automated backups

# Security best practices:
# - NEVER commit this file with real secrets
# - Use environment-specific .env files (.env.production, .env.development)
# - Rotate secrets regularly (at least quarterly)
# - Use a secrets manager in production (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Restrict file permissions: chmod 600 .env
# - Enable HTTPS/TLS for all production endpoints
# - Implement rate limiting and DDoS protection
# - Regularly audit access logs
# - Use database connection pooling
# - Implement proper user session management with a database
# - Enable API request logging for security audits
# - Consider implementing 2FA for admin accounts

# Authentication system notes:
# - Current system uses PBKDF2 password hashing (100k iterations)
# - Users are stored in memory (not persistent across restarts)
# - FOR PRODUCTION: Implement database-backed user management
# - FOR PRODUCTION: Consider using OAuth2/OIDC providers
# - FOR PRODUCTION: Implement password complexity requirements
# - FOR PRODUCTION: Add account lockout after failed login attempts
# - FOR PRODUCTION: Log all authentication events for security monitoring
