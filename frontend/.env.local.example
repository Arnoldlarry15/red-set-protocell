# API Base URL for the backend server
#
# === LOCAL DEVELOPMENT ===
# For local development, point to your local backend server:
VITE_API_BASE_URL=http://localhost:8000
#
# === PRODUCTION (VERCEL) ===
# For production on Vercel, set this environment variable in Vercel Dashboard:
# Project → Settings → Environment Variables → Add
#
# IMPORTANT: In production, use the relative path to leverage Vercel's routing
# Example: VITE_API_BASE_URL=/api
# Or use your full domain: VITE_API_BASE_URL=https://your-vercel-domain.vercel.app/api
#
# The backend will be accessible at /api/* routes via vercel.json configuration
