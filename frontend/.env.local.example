# API Base URL for the backend server
#
# === LOCAL DEVELOPMENT ===
# For local development, point to your local backend server:
VITE_API_BASE_URL=http://localhost:8000
#
# === PRODUCTION (Firebase Hosting + Cloud Run) ===
# For production, set this to the Cloud Run API domain:
# VITE_API_BASE_URL=https://api.redset.app
#
# NOTE: Do NOT put secrets or private keys in this file.
# Frontend environment variables are embedded in the static build and are
# publicly visible. Only non-sensitive public configuration belongs here.
